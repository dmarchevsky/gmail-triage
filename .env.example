# ── Required ────────────────────────────────────────────────────────────────
# Encryption key for secrets at rest (Gmail token, Telegram token).
# Generate with: openssl rand -hex 32
# The app REFUSES TO START with an empty or default value.
APP_SECRET_KEY=

# ── Remote access: Cloudflare Tunnel + Access (see docs/remote-access.md) ──
# The UI has no password of its own: it is reachable only through a cloudflared
# tunnel behind a Cloudflare Access application that signs you in with Google.
# The app verifies the Access JWT and allows only the emails listed below.
# The app REFUSES TO START unless these are set (or DEV_AUTH=true).
# Starts the cloudflared service.
COMPOSE_PROFILES=tunnel
CLOUDFLARE_TUNNEL_TOKEN=
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# AUD tag of the Access application (comma-separated if more than one).
CF_ACCESS_AUD=
# Only needed if the Zero Trust team was renamed (iss keeps the original name).
# CF_ACCESS_ISSUER=
# Google account(s) allowed to use the app (comma-separated).
CF_ACCESS_ALLOWED_EMAILS=you@gmail.com

# Local development ONLY: disables authentication entirely. Mutually exclusive
# with CF_ACCESS_* (the app refuses to start with both). Leave COMPOSE_PROFILES
# unset locally so no tunnel is started.
# DEV_AUTH=true

# PostgreSQL password for the bundled postgres service (docker compose).
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=

# Database URL. Compose sets this automatically to the bundled Postgres.
# Outside Docker, leave unset to use a local SQLite file under ./data.
# DATABASE_URL=postgresql+psycopg://mailtriage:<password>@localhost:5432/mailtriage

# ── LLM (llama.cpp or any OpenAI-compatible server) ────────────────────────
# Recommended: run llama.cpp on the host (e.g. Vulkan on AMD iGPU) and point
# this at it. host.docker.internal resolves to the host from the container.
LLM_BASE_URL=http://host.docker.internal:8081/v1
# Model name sent in requests; ignored by single-model llama.cpp servers.
LLM_MODEL=local

# ── Optional ────────────────────────────────────────────────────────────────
# Timezone for schedules and logs.
TZ=America/Los_Angeles
